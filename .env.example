# apm-registry configuration.
#
# Every variable the config loader reads appears here. Copy to `.env` for local
# development; the process reads the environment, not this file, so export them
# or use a loader of your choice. Invalid values fail startup rather than
# starting degraded (TR-30).
#
# Reference: docs/specs/03-architecture.md §10.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Listen port.
PORT=3000

# Public origin of this registry, no trailing slash. Used to build the install
# snippets and absolute links. Required in production.
APM_REGISTRY_BASE_URL=http://localhost:3000

# Refuse to serve over plain HTTP unless this is explicitly true (TR-16).
# Development only.
APM_REGISTRY_ALLOW_INSECURE_HTTP=true

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Root directory for the SQLite database, the blob store and upload temp files.
# Must be a LOCAL volume — SQLite locking is unreliable on network filesystems.
APM_REGISTRY_DATA_DIR=./data

# Metadata store DSN. Defaults to sqlite://<data dir>/registry.db.
# APM_REGISTRY_DB_URL=sqlite://./data/registry.db

# Blob backend. `fs` is the only implementation in v1.
APM_REGISTRY_BLOB_BACKEND=fs

# ---------------------------------------------------------------------------
# Publish limits
# ---------------------------------------------------------------------------

# Compressed upload cap, in bytes. Exceeding it aborts mid-stream with 413.
APM_REGISTRY_MAX_ARCHIVE_BYTES=52428800

# Total uncompressed size cap, in bytes. Measured while expanding, never from
# the archive's declared sizes — declared sizes are attacker-controlled (TR-13).
APM_REGISTRY_MAX_UNCOMPRESSED_BYTES=104857600

# Entry-count cap (zip-bomb defence).
APM_REGISTRY_MAX_ARCHIVE_ENTRIES=10000

# Accepted publish media types, comma-separated. Narrow to application/gzip
# alone to pre-comply with the OpenAPM v0.2 direction (ADR-0004).
APM_REGISTRY_ACCEPTED_MEDIA_TYPES=application/zip,application/gzip

# Require apm.yml's `version` to equal the version in the URL. MS-API §6.5
# leaves this to registry policy; we default to strict.
APM_REGISTRY_REQUIRE_MANIFEST_VERSION_MATCH=true

# ---------------------------------------------------------------------------
# Reserved — not read by the loader yet
# ---------------------------------------------------------------------------

# Web UI session signing key (MVP 3).
# APM_REGISTRY_SESSION_SECRET=

# Rate-limit window and quota (MVP 4).
# APM_REGISTRY_RATE_LIMIT_REQUESTS=
# APM_REGISTRY_RATE_LIMIT_WINDOW=
